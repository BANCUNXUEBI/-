# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# PaddleOCR API Token
# IMPORTANT SECURITY NOTE: Injecting the token via BuildConfig/.env is for internal testing ONLY.
# In a formal production environment, you should route these OCR requests through a backend server 
# proxy to prevent your token from being extracted from a decompiled APK.
PADDLEOCR_TOKEN=MY_PADDLEOCR_TOKEN
